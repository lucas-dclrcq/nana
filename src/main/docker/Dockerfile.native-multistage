# syntax=docker/dockerfile:1
## Stage 1: build the native executable (Quinoa builds the frontend with its own pinned Node)
FROM quay.io/quarkus/ubi9-quarkus-mandrel-builder-image:jdk-21 AS build
USER quarkus
WORKDIR /code
COPY --chown=quarkus:quarkus mvnw /code/mvnw
COPY --chown=quarkus:quarkus .mvn /code/.mvn
COPY --chown=quarkus:quarkus pom.xml /code/pom.xml
COPY --chown=quarkus:quarkus src /code/src
RUN ./mvnw package -Dnative -DskipTests \
    -Dquarkus.quinoa.package-manager-install=true \
    -Dquarkus.quinoa.package-manager-install.node-version=22.23.1

## Stage 2: minimal rootless runtime, compatible with arbitrary runAsUser/runAsGroup
FROM quay.io/quarkus/ubi9-quarkus-micro-image:2.0
WORKDIR /work/
COPY --from=build --chown=0:0 --chmod=0555 /code/target/*-runner /work/application

ENV HOME=/tmp
EXPOSE 8080
USER 1001

ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0", "-Dvertx.cacheDirBase=/tmp/vertx-cache"]
